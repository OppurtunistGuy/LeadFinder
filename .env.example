# Copy this file to .env and fill it in. Never share the .env file.

# Needed for live research on any niche (Claude API with web search).
# Without it the app only shows the 3 sample niches researched on 18 Oct 2026.
ANTHROPIC_API_KEY=

# Meta Ad Library scout (UK, Germany, Europe). Needs your ID confirmed at facebook.com/ads/library/api.
# Paste a token from the Graph API Explorer. It lasts only an hour or two on its own.
META_ACCESS_TOKEN=
# Optional but recommended: with both of these the app swaps the short token for a ~60 day one
# and refreshes it for you. The app secret stays on your computer. Never share it.
META_APP_ID=
META_APP_SECRET=

# Optional
PORT=3000
